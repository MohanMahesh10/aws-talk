# DEMO MODE
# true  = mocked extraction, deterministic workflow, no external model
# false = call the configured OpenAI-compatible API
DEMO_MODE=true
SECRET_KEY=

# Azure Responses API (used only when DEMO_MODE=false)
# Example: https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/responses
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-5.4-mini

# App
API_HOST=127.0.0.1
API_PORT=8000
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
API_BASE_URL=http://127.0.0.1:8000

# SQLite
DATABASE_URL=sqlite:///./data/reem.db

# Agent limits
MAX_AGENT_LOOPS=3
PAYMENT_RETRY_LIMIT=3
CIRCUIT_BREAKER_THRESHOLD=3
RATE_LIMIT_PER_CLAIM=40
